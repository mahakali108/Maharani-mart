# =============================================================================
# Supabase — PRIMARY backend (Postgres, Auth, RLS, all business data). Required.
# =============================================================================
# Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL, used for auth email redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required in the x-webhook-secret header for /api/webhooks
WEBHOOK_SECRET=generate-a-long-random-string


# =============================================================================
# Appwrite — MEDIA / FILE STORAGE ONLY. Optional.
# -----------------------------------------------------------------------------
# Appwrite stores images and documents. It is NOT an auth provider and holds no
# business data (no Appwrite Database). If these are unset, uploads are
# disabled with a clear message and every image already stored in Supabase
# Storage keeps rendering exactly as before.
# Setup instructions: docs/appwrite_setup.md
# =============================================================================
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id

# Server-only API key with scopes: files.read, files.write.
# NEVER prefix this with NEXT_PUBLIC_ and never commit a real value.
APPWRITE_API_KEY=your-appwrite-api-key

# Bucket for publicly readable media (product images, banners, brand logos,
# category images, retailer avatars).
# Canonical name. The legacy alias APPWRITE_BUCKET_ID is still read as a
# fallback for older deployments — set exactly ONE of the two.
APPWRITE_STORAGE_BUCKET_ID=maharani-media

# Bucket for private media (retailer KYC documents). Files here get NO public
# read permission and are streamed only via /api/media/private after a
# Supabase session + role check. If unset, the public bucket is used as a
# fallback — set a dedicated bucket before going to production.
APPWRITE_PRIVATE_BUCKET_ID=maharani-documents

# Optional browser-side mirrors, used only to build public file URLs.
# These are NOT secrets: both values already appear inside every public
# Appwrite file URL. Leave unset to reuse the server values above.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id


# =============================================================================
# Turso — OPTIONAL secondary read cache. Safe to leave completely unset.
# -----------------------------------------------------------------------------
# Holds derived, disposable data only (currently: search suggestions).
# Never authoritative. Login, cart, checkout, orders, credit, pricing and
# admin permissions do not read from Turso and are unaffected if it is down.
# Details: docs/turso.md
# =============================================================================
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io

# Server-only token. NEVER prefix with NEXT_PUBLIC_.
TURSO_AUTH_TOKEN=your-turso-auth-token
