# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL, used for auth email redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required in the x-webhook-secret header for /api/webhooks
WEBHOOK_SECRET=generate-a-long-random-string

# -----------------------------------------------------------------------------
# Firebase Cloud Storage — files/images ONLY
# Do NOT use Firebase for Auth, Firestore, or business data.
# Supabase remains the source of truth for Auth, Postgres, RLS, and roles.
# -----------------------------------------------------------------------------

# Browser-safe Firebase web app config (public by design, like the anon key).
# Never put a service-account private key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Used for upload/delete/signed URLs.
# FIREBASE_ADMIN_PRIVATE_KEY may contain escaped newlines (\n).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional override if the Admin bucket name differs from the public bucket.
# FIREBASE_ADMIN_STORAGE_BUCKET=
