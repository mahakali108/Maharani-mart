# =============================================================================
# Supabase — PRIMARY backend (Postgres, Auth, RLS, all business data). Required.
# =============================================================================
# Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL, used for auth email redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required in the x-webhook-secret header for /api/webhooks
WEBHOOK_SECRET=generate-a-long-random-string


# =============================================================================
# Turso — OPTIONAL secondary read cache. Safe to leave completely unset.
# -----------------------------------------------------------------------------
# Holds derived, disposable data only (currently: search suggestions).
# Never authoritative. Login, cart, checkout, orders, credit, pricing and
# admin permissions do not read from Turso and are unaffected if it is down.
# Details: docs/turso.md
# =============================================================================
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io

# Server-only token. NEVER prefix with NEXT_PUBLIC_.
TURSO_AUTH_TOKEN=your-turso-auth-token


# =============================================================================
# Maharani AI — OPTIONAL until /ai workspaces are enabled.
# All values below are server-only. NEVER use NEXT_PUBLIC_ prefixes.
# Providers: openai, gemini, or openai-compatible.
# Gemini uses its OpenAI-compatible endpoint unless AI_BASE_URL is overridden.
# =============================================================================
AI_PROVIDER=openai-compatible
AI_API_KEY=your-server-only-provider-key
AI_MODEL=your-tool-capable-streaming-model
# AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=900

# 32+ random characters, used to sign short-lived cart confirmations.
AI_ACTION_SIGNING_SECRET=generate-at-least-32-random-characters

# Optional fallback; used only after a primary provider failure and only when
# all three required fallback values are configured.
# AI_FALLBACK_PROVIDER=gemini
# AI_FALLBACK_API_KEY=your-server-only-fallback-key
# AI_FALLBACK_MODEL=your-fallback-tool-capable-model
# AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai


# =============================================================================
# Retailer-facing company/service details — OPTIONAL display configuration.
# Leave unset when unconfirmed. The homepage never invents a dispatch promise,
# delivery estimate, GSTIN or support telephone number.
# COMPANY_PHONE / COMPANY_GSTIN are also used by the existing help/invoice pages.
# =============================================================================
# COMPANY_NAME=
# COMPANY_PHONE=
# COMPANY_GSTIN=
# COMPANY_DISPATCH_NOTE=
# COMPANY_DELIVERY_ESTIMATE=


# =============================================================================
# Firebase — Phase 1 SDK foundation. OPTIONAL, and completely separate from
# Supabase. Leave unset and the app behaves exactly as before: Firebase is not
# initialised, no Firebase service is contacted, and no Firebase data exists.
# Supabase (auth, RLS, business data) stays primary; do not migrate data yet.
# =============================================================================
# Project settings > General > Your apps > Web app (safe to expose publicly).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account (Project settings > Service accounts > Generate new private
# key). Server-only — NEVER prefix with NEXT_PUBLIC_. The private key is usually
# pasted as a single line with literal \n escapes; lib/firebase/config.ts
# normalises that (and quoted / real multi-line values) automatically.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Reserved for Phase 2 (listed now so environments can be prepared).
# Not read by any code yet — none of the three enables anything on its own, and
# /api/health keeps reporting Firebase as "missing" until the Firebase values
# above are actually filled in.
SESSION_SECRET=
SUPER_ADMIN_EMAILS=
SEED_ADMIN_PASSWORD=
