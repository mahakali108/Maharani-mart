# =============================================================================
# Supabase — PRIMARY backend (Postgres, Auth, RLS, all business data). Required.
# =============================================================================
# Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL, used for auth email redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Phone OTP Login — OPTIONAL but required for mobile-number OTP sign-in.
# -----------------------------------------------------------------------------
# The OTP login flow uses supabase.auth.signInWithOtp({ phone }) which
# requires an SMS provider configured in the Supabase dashboard:
#
#   Dashboard > Authentication > Providers > Phone
#   → Enable "Phone" provider
#   → Choose SMS provider (Twilio, MessageBird, Vonage, etc.)
#   → Enter the provider's credentials (Account SID, Auth Token, etc.)
#
# Without this configuration, the OTP login tab will show:
#   "Phone login is temporarily unavailable. Please use email/password."
#
# IMPORTANT:
# - Do NOT build a custom OTP system or store OTPs in the database.
# - Supabase handles OTP generation, delivery, expiration and rate-limiting.
# - The phone number must be in E.164 format (+91XXXXXXXXXX).
# - Indian numbers are validated server-side before the OTP request.
# =============================================================================

# Shared secret required in the x-webhook-secret header for /api/webhooks
WEBHOOK_SECRET=generate-a-long-random-string


# =============================================================================
# Turso — OPTIONAL secondary read cache. Safe to leave completely unset.
# -----------------------------------------------------------------------------
# Holds derived, disposable data only (currently: search suggestions).
# Never authoritative. Login, cart, checkout, orders, credit, pricing and
# admin permissions do not read from Turso and are unaffected if it is down.
# Details: docs/turso.md
# =============================================================================
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io

# Server-only token. NEVER prefix with NEXT_PUBLIC_.
TURSO_AUTH_TOKEN=your-turso-auth-token


# =============================================================================
# Maharani AI — OPTIONAL until /ai workspaces are enabled.
# All values below are server-only. NEVER use NEXT_PUBLIC_ prefixes.
# Providers: openai, gemini, or openai-compatible.
# Gemini uses its OpenAI-compatible endpoint unless AI_BASE_URL is overridden.
# =============================================================================
AI_PROVIDER=openai-compatible
AI_API_KEY=your-server-only-provider-key
AI_MODEL=your-tool-capable-streaming-model
# AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=900

# 32+ random characters, used to sign short-lived cart confirmations.
AI_ACTION_SIGNING_SECRET=generate-at-least-32-random-characters

# Optional fallback; used only after a primary provider failure and only when
# all three required fallback values are configured.
# AI_FALLBACK_PROVIDER=gemini
# AI_FALLBACK_API_KEY=your-server-only-fallback-key
# AI_FALLBACK_MODEL=your-fallback-tool-capable-model
# AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
